# Leave both empty: the app then calls /api on its own origin (Vite dev proxy / Vercel rewrite),
# which keeps the refresh cookie first-party. Pointing them at the backend host breaks session refresh.
VITE_API_URL=
VITE_API_BASE_URL=
VITE_WS_URL=https://leo-chat-backend.onrender.com/ws
VITE_APP_ENV=local
VITE_SENTRY_DSN=
VITE_MAX_UPLOAD_MB=10
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
